{
  "name": "aow5-tracker",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "Always-on-top farm tracker overlay for the Dota 2 custom game Age of Weapons 5",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/gen-icons.ts && electron-vite dev",
    "build": "node scripts/gen-icons.ts && tsc -b && electron-vite build",
    "check-types": "tsc -b",
    "preview": "electron-vite preview",
    "test": "node --test \"core/**/*.test.ts\" \"src/lib/*.test.ts\" \"src/features/**/*.test.ts\"",
    "gen-icons": "node scripts/gen-icons.ts",
    "gen-tray-icon": "node scripts/gen-tray-icon.ts",
    "gen-app-icon": "node scripts/gen-app-icon.ts",
    "release": "node scripts/gen-app-icon.ts && electron-builder --publish always",
    "capture": "node spike/capture-gsi.ts",
    "analyse": "node spike/analyse.ts",
    "resolve": "node spike/resolve.ts"
  },
  "dependencies": {
    "aow5-api-contract": "workspace:*",
    "aow5-shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
