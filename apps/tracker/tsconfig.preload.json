{
  "compilerOptions": {
    "target": "ES2022",
    /*
     * The preload is the one file that lives in both worlds: it runs in the
     * renderer process — so it has `window` and `location` — while keeping
     * Node's types for the Electron module it bridges. Neither of the other two
     * projects describes that, which is why it gets its own.
     */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.preload.tsbuildinfo"
  },
  "include": [
    "electron/preload.ts",
    "core/cards.ts",
    "core/i18n.ts",
    "core/locale.ru.ts",
    "core/events.ts",
    "core/ipc.ts",
    "core/history.ts",
    "core/locale.ts",
    "core/packs.ts",
    "core/shortcuts.ts",
    "core/sounds.ts",
    "core/style.ts",
    "core/stats.ts"
  ]
}
