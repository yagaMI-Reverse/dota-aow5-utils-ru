# Copy to /srv/aow5/.env on the server, fill it in, and `chmod 600` it.
#
# Not in the repository and never baked into an image: docker compose reads it
# at deploy time (see infra/deploy.sh) and passes only what each service needs.

# The DuckDNS name the site is served from. Caddy requests a certificate for
# exactly this, so it must already resolve to this machine before the first
# deploy.
SITE_DOMAIN=aow5.duckdns.org

# Where Let's Encrypt sends expiry warnings. Required.
ACME_EMAIL=you@example.com

# The DuckDNS subdomain (the part before .duckdns.org) and its token, used by
# the refresh timer in infra/systemd/. The token is a credential.
DUCKDNS_SUBDOMAIN=aow5
DUCKDNS_TOKEN=

# The Freesound API key the tracker's sound search is proxied through.
#
# Optional. Without it the API answers "not configured", the picker hides its
# search box, and everything else works exactly as before — so a deployment that
# does not want this feature simply leaves the line out.
#
# Get one at https://freesound.org/apiv2/apply (a free account, then "API
# credentials"; the plain token is enough — the OAuth2 client secret beside it
# is for downloading original files, which this never does). It is a credential:
# the quota is 2000 requests a day and it is shared by every tracker pointed at
# this server.
FREESOUND_TOKEN=
